{
	"unet": {
		"class_type": "UNETLoader",
		"inputs": {
			"unet_name": "qwen_image_2.1_turbo_bf16.safetensors",
			"weight_dtype": "default"
		}
	},
	"clip": {
		"class_type": "CLIPLoader",
		"inputs": {
			"clip_name": "qwen3vl_8b_bf16.safetensors",
			"type": "qwen_image",
			"device": "default"
		}
	},
	"vae": {
		"class_type": "VAELoader",
		"inputs": {
			"vae_name": "qwen_image_2.1_vae_bf16.safetensors"
		}
	},
	"cache": {
		"class_type": "QwenImage21Cache",
		"inputs": {
			"model": ["unet", 0],
			"device": "auto",
			"dtype": "default"
		}
	},
	"positive": {
		"class_type": "TextEncodeQwenImage21",
		"inputs": {
			"clip": ["clip", 0],
			"vae": ["vae", 0],
			"prompt": "",
			"negative_prompt": "",
			"resolution": 1024
		}
	},
	"noise": {
		"class_type": "RandomNoise",
		"inputs": {
			"noise_seed": 0
		}
	},
	"guider": {
		"class_type": "CFGGuider",
		"inputs": {
			"model": ["cache", 0],
			"positive": ["positive", 0],
			"negative": ["positive", 1],
			"cfg": 1
		}
	},
	"sampler": {
		"class_type": "KSamplerSelect",
		"inputs": {
			"sampler_name": "euler"
		}
	},
	"sigmas": {
		"class_type": "ManualSigmas",
		"inputs": {
			"sigmas": "1.0, 0.978453, 0.95418, 0.926626, 0.89508, 0.845148, 0.704534, 0.414568, 0"
		}
	},
	"sample": {
		"class_type": "SamplerCustomAdvanced",
		"inputs": {
			"noise": ["noise", 0],
			"guider": ["guider", 0],
			"sampler": ["sampler", 0],
			"sigmas": ["sigmas", 0],
			"latent_image": ["positive", 2]
		}
	},
	"decode": {
		"class_type": "VAEDecode",
		"inputs": {
			"samples": ["sample", 0],
			"vae": ["vae", 0]
		}
	},
	"save": {
		"class_type": "SaveImage",
		"inputs": {
			"images": ["decode", 0],
			"filename_prefix": "manga-maker/edit"
		}
	}
}
